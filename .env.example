# =============================================================
# CourtHub — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file.
# =============================================================

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://courthub:courthub@localhost:5432/courthub

# ── JWT Auth ──────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-secret
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Backend Server ────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Frontend ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ── AWS (leave blank for local dev — image upload falls back to local disk) ──
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=courthub-images
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Email (Nodemailer) ────────────────────────────────────────
# For dev: use Mailtrap (https://mailtrap.io) — free sandbox SMTP
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@courthub.dev

# ── Rate Limiting ─────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=10
